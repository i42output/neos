with Ada.Text_IO_Engine;

package body Ada.Wide_Wide_Text_IO.Text_Streams is

   function Stream (File : in File_Type) return Stream_Access is
   begin
      Text_IO_Engine.Check_Open (File.File);
      return File.File.Stream'Access;
   end Stream;

end Ada.Wide_Wide_Text_IO.Text_Streams;
