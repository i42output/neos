--  Alterations (neos):
--  the private part is neos's (with a with clause for Interfaces, which it
--  uses); besides the full type of Time, it declares subprograms and
--  constants for Calendar's child packages. The layout of the declarations
--  (line breaks and alignment) is adjusted.
--  (See languages/packages/ada/NOTICE.)

with Interfaces;

package Ada.Calendar
   with Nonblocking is
   type Time is private;

   subtype Year_Number  is Integer range 1901 .. 2399;
   subtype Month_Number is Integer range 1 .. 12;
   subtype Day_Number   is Integer range 1 .. 31;
   subtype Day_Duration is Duration range 0.0 .. 86_400.0;

   function Clock return Time;

   function Year   (Date : Time) return Year_Number;
   function Month  (Date : Time) return Month_Number;
   function Day    (Date : Time) return Day_Number;
   function Seconds(Date : Time) return Day_Duration;

   procedure Split (Date  : in Time;
                    Year    : out Year_Number;
                    Month   : out Month_Number;
                    Day     : out Day_Number;
                    Seconds : out Day_Duration);

   function Time_Of(Year  : Year_Number;
                    Month   : Month_Number;
                    Day     : Day_Number;
                    Seconds : Day_Duration := 0.0)
    return Time;

   function "+" (Left : Time;   Right : Duration) return Time;
   function "+" (Left : Duration; Right : Time) return Time;
   function "-" (Left : Time;   Right : Duration) return Time;
   function "-" (Left : Time;   Right : Time) return Duration;

   function "<" (Left, Right : Time) return Boolean;
   function "<="(Left, Right : Time) return Boolean;
   function ">" (Left, Right : Time) return Boolean;
   function ">="(Left, Right : Time) return Boolean;

   Time_Error : exception;

private

   --  A time is a number of nanoseconds since 2150-01-01 00:00:00 UTC (the
   --  middle of the range of Year_Number, so that the range of the type,
   --  about 292 years either side, includes every year of it in every time
   --  zone). Leap seconds are not counted (as by the host's clock).

   type Time is new Interfaces.Integer_64;

   --  (for Calendar's children)

   Nanoseconds_Per_Second : constant := 1_000_000_000;
   Nanoseconds_Per_Day    : constant := 86_400 * Nanoseconds_Per_Second;

   --  The nanoseconds since 1970-01-01 00:00:00 UTC of Time's origin
   Unix_Origin : constant := 65_744 * Nanoseconds_Per_Day;

   --  The days from Time's origin to a date of the proleptic Gregorian
   --  calendar, and the date of a number of days from it
   function Days_Of (Year, Month, Day : Integer) return Interfaces.Integer_64;
   procedure Date_Of (Days  : Interfaces.Integer_64;
                      Year  : out Integer;
                      Month : out Integer;
                      Day   : out Integer);

   --  Whether a date is a date of the calendar
   function Is_Date (Year, Month, Day : Integer) return Boolean;

   --  The offset (minutes) of the local time zone from UTC at a time: Unknown
   --  if it is not known
   Unknown : constant := Integer'First;
   function Local_Offset (Date : Time) return Integer;

   --  Date split in the time zone of the offset Offset (minutes): Time_Error
   --  if the year is not a Year_Number
   procedure Split_Time (Date    : Time;
                         Offset  : Integer;
                         Year    : out Year_Number;
                         Month   : out Month_Number;
                         Day     : out Day_Number;
                         Seconds : out Interfaces.Integer_64);

   --  The time of a date and the nanoseconds since its start in the time
   --  zone of the offset Offset (minutes): Time_Error if the date is not a
   --  date of the calendar or the time is not a value of Time
   function Make_Time (Year, Month, Day : Integer;
                       Nanoseconds      : Interfaces.Integer_64;
                       Offset           : Integer) return Time;

   --  Durations as nanoseconds
   function To_Nanoseconds (D : Duration) return Interfaces.Integer_64;
   function To_Duration (N : Interfaces.Integer_64) return Duration;

end Ada.Calendar;
