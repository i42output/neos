--
--  Alterations (neos):
--  The visible declarations are those of the published standard, ISO/IEC
--  8652:2023 (from AI12-0384-2), which replaced the draft's (Character_Count,
--  Clear, the Get, Wide_Get, Wide_Wide_Get and End_of_Line operations of
--  Root_Buffer_Type, and their Post'Class aspects): the functions Get,
--  Wide_Get, Wide_Wide_Get, Get_UTF_8 and Wide_Get_UTF_16 are declared, and the
--  Default_Initial_Condition of Buffer_Type is removed. The
--  implementation-defined values are given: Text_Buffer_Count'Last is
--  Integer'Last, New_Line_Count is 1. The private part is neos's, and with
--  clauses for Ada.Finalization and Ada.Streams are added for it.
--  (See languages/packages/ada/NOTICE.)

with Ada.Finalization;
with Ada.Streams;
package Ada.Strings.Text_Buffers.Unbounded
   with Preelaborate, Nonblocking, Global => null is

   type Buffer_Type is new Root_Buffer_Type with private;

   function Get (
      Buffer : in out Buffer_Type)
      return String
      with Post'Class =>
         Get'Result'First = 1 and then Current_Indent (Buffer) = 0;

   function Wide_Get (
      Buffer : in out Buffer_Type)
      return Wide_String
      with Post'Class =>
         Wide_Get'Result'First = 1 and then Current_Indent (Buffer) = 0;

   function Wide_Wide_Get (
      Buffer : in out Buffer_Type)
      return Wide_Wide_String
      with Post'Class =>
         Wide_Wide_Get'Result'First = 1 and then Current_Indent (Buffer) = 0;

   function Get_UTF_8 (
      Buffer : in out Buffer_Type)
      return UTF_Encoding.UTF_8_String
      with Post'Class =>
         Get_UTF_8'Result'First = 1 and then Current_Indent (Buffer) = 0;

   function Wide_Get_UTF_16 (
      Buffer : in out Buffer_Type)
      return UTF_Encoding.UTF_16_Wide_String
      with Post'Class =>
         Wide_Get_UTF_16'Result'First = 1 and then Current_Indent (Buffer) = 0;

   -- Nonabstract overridings of each inherited operation:

   overriding procedure Put (
      Buffer : in out Buffer_Type;
      Item   : in     String);

   overriding procedure Wide_Put (
      Buffer : in out Buffer_Type;
      Item   : in     Wide_String);

   overriding procedure Wide_Wide_Put (
      Buffer : in out Buffer_Type;
      Item   : in     Wide_Wide_String);

   overriding procedure Put_UTF_8 (
      Buffer : in out Buffer_Type;
      Item   : in     UTF_Encoding.UTF_8_String);

   overriding procedure Wide_Put_UTF_16 (
      Buffer : in out Buffer_Type;
      Item   : in     UTF_Encoding.UTF_16_Wide_String);

   overriding procedure New_Line (Buffer : in out Buffer_Type);

private
   type Text_Access is access Text_Array;

   type Text_Storage is new Ada.Finalization.Controlled with record
      Data : Text_Access := null;  -- (null or with lower bound 1)
      Last : Text_Buffer_Count := 0;  -- the text is Data (1 .. Last)
   end record;

   overriding procedure Adjust (Object : in out Text_Storage);
   overriding procedure Finalize (Object : in out Text_Storage);

   procedure Read
     (Stream : not null access Ada.Streams.Root_Stream_Type'Class;
      Item   : out Text_Storage);
   procedure Write
     (Stream : not null access Ada.Streams.Root_Stream_Type'Class;
      Item   : in Text_Storage);
   for Text_Storage'Read use Read;
   for Text_Storage'Write use Write;
   -- (as the Text_Array of the text)

   type Buffer_Type is new Root_Buffer_Type with record
      Text : Text_Storage;
   end record;
end Ada.Strings.Text_Buffers.Unbounded;
