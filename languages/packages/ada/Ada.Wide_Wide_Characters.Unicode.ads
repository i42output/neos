--  The character data of the Unicode Character Database, version 15.1.0, that
--  Ada.Wide_Wide_Characters.Handling needs: general categories (reduced to the
--  classes the RM's classification functions distinguish), simple case mappings,
--  the first code points of decomposition mappings, and the characters that
--  cannot occur in Normalization Form KC.
--
--  (One alteration: the categories of FEMININE ORDINAL INDICATOR and MASCULINE
--  ORDINAL INDICATOR (16#AA#, 16#BA#) are letter_lowercase, their category
--  before Unicode 6.1, as the ACATS (CXA3005, CXA3007) expects.)
--
--  The tables are generated (by the strings area's gen/build_unicode.py) from
--  UnicodeData.txt and the NFKC normalization data of the Unicode Character
--  Database 15.1.0: Copyright (c) 1991-2023 Unicode, Inc.; see
--  https://www.unicode.org/terms_of_use.html (Unicode License v3).

private package Ada.Wide_Wide_Characters.Unicode is
   pragma Pure (Unicode);

   Version : constant String := "Unicode 15.1.0";

   type Code_Point is range 0 .. 16#7FFF_FFFF#;

   type Category is
     (Other_Graphic,         -- every other category (and unassigned)
      Control,               -- Cc
      Private_Or_Surrogate,  -- Co, Cs
      Line_Separator,        -- Zl, Zp
      Format,                -- Cf
      Upper,                 -- Lu
      Lower,                 -- Ll
      Other_Letter,          -- Lt, Lm, Lo, Nl
      Digit,                 -- Nd
      Mark,                  -- Mn, Mc
      Connector,             -- Pc
      Space,                 -- Zs
      Upper_Even,            -- Lu at even code points, Ll at odd ones
      Upper_Odd);            -- Lu at odd code points, Ll at even ones

   type Category_Range is record
      First, Last : Code_Point;
      Class       : Category;
   end record;

   type Category_Ranges is array (Positive range <>) of Category_Range;

   type Code_Range is record
      First, Last : Code_Point;
   end record;

   type Code_Ranges is array (Positive range <>) of Code_Range;

   --  A run of a mapping: the code points First, First + Stride, ... Last
   --  map to Code + Value (Stride 1 or 2), or all to Value (Stride 0).

   type Mapping_Run is record
      First, Last : Code_Point;
      Stride      : Natural;
      Value       : Integer;
   end record;

   type Mapping_Runs is array (Positive range <>) of Mapping_Run;

   function Category_Of (C : Code_Point) return Category;
   function Map (Runs : Mapping_Runs; C : Code_Point) return Code_Point;
   function In_Runs (Runs : Mapping_Runs; C : Code_Point) return Boolean;
   function Is_NFKC (C : Code_Point) return Boolean;

