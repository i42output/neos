// neoscript example: nested ranges (as range.py and range.js)

using neo.string;
using neo.stream;

fn f(l, m : i64) -> i64
{
    i64 cnt = 0;
    for (i : i64 = 0; i < l; i = i + 1)
    {
        for (j : i64 = 0; j < m; j = j + 1)
        {
            cnt = cnt + 1;
        }
    }
    return cnt;
}

proc main()
{
    neo::print(neo::to_string(f(99999 + 1, 9999 + 1)) + "\n");
}
