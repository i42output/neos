// neoscript example: Fibonacci
using neoscript.test;
using neo.string;
using neo.stream;
// functions are pure
fn add(x, y : i32) -> i32
{
    return x + y;
}
// functions are pure
fn fib(y : i32) -> i32 
{
    if (y < 2) 
        return y; 
    else
        return add(fib(y-1), fib(y-2));
}
// procedures are impure
proc main()
    s : string;
{
   neo::print("Enter a positive "
           "integer: ");
   neo::input(s);
   neo::print("Fibonacci(" + s + ") = " + neo::to_string(fib(neo::to_integer(s))) + "\n");
}
