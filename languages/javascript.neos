(*
  ECMAScript (ECMAScript 2025): the syntax of scripts and modules. Each construct is a concept of the JavaScript concept
  library (neos.javascript) that the JavaScript compiler (javascript.ncp) builds its syntax tree from (a construct's
  children are the constructs within its source; a "postfix" construct, e.g. a call's arguments or a binary operator and its
  right operand, also takes the construct that precedes it). The compiler checks what the grammar does not: early errors,
  reserved words, automatic semicolon insertion (a statement's semicolon is optional here) and the context of contextual
  keywords.
*)

%{
    meta: {
        language: "javascript"
        description: "JavaScript (ECMAScript)"
        source.file.extension: ".js"
        source.package.specification.file.extension: ".js"
        source.package.implementation.file.extension: ".js"
        copyright: "Copyright (C) 2026 Leigh Johnston"
        version: "0.2.0"
    }

    stages: {
        parser : {
            text : [ "#{" "}#" ]
            root : program
        }
    }

    pipeline: [
        parser
    ]

    libraries: [
        neos.core
        neos.math.universal
        neos.javascript
    ]

    discard: [
        WS
        S
        whitespace
        hspace
        comment
    ]
}%

#{
    (* --- whitespace, line terminators and comments *)

    WS ::= [ whitespace ] ;
    S ::= [ hspace ] ;
    whitespace ::= { white space character | html close comment line | line terminator | comment } + ;
    hspace ::= { white space character | single line block comment } + ;
    white space character ::= U+0009 | U+000B | U+000C | U+0020 | U+00A0 | U+FEFF | U+1680 | U+2000 | U+2001 | U+2002 | U+2003 |
        U+2004 | U+2005 | U+2006 | U+2007 | U+2008 | U+2009 | U+200A | U+202F | U+205F | U+3000 ;
    line terminator ::= U+000A | U+000D | U+2028 | U+2029 ;
    comment ::= line comment | block comment | html open comment ;
    (* Annex B.1.1: HTML-like comments ("<!--" begins a single line comment; "-->" does at the start of a line) *)
    html open comment ::= "<!--" , { line comment character } ;
    html close comment line ::= line terminator , html close comment ;
    html close comment ::= { white space character | single line block comment } , "-->" , { line comment character } ;
    line comment ::= "//" , { line comment character } ;
    line comment character ::= ( U+0001 .. '\xFF' - ( U+000A | U+000D | '\xE2' ) ) | '\x00' | ( '\xE2' , '\x80' , not LS PS byte ) | ( '\xE2' , ( ! '\x80' .. '\x80' ) ) ;
    not LS PS byte ::= ( U+0001 .. '\xFF' - ( '\xA8' | '\xA9' ) ) | '\x00' ;
    not slash or star ::= ( U+0001 .. '\xFF' - ( '/' | '*' ) ) | '\x00' ;
    not slash star or line terminator ::= ( U+0001 .. '\xFF' - ( '/' | '*' | U+000A | U+000D | '\xE2' ) ) | '\x00' ;
    not line terminator byte ::= ( U+0001 .. '\xFF' - ( U+000A | U+000D ) ) | '\x00' ;
    block comment ::= "/*" , { ( ! '*' .. '*' ) | '\x00' | ( { '*' } + , not slash or star ) } , { '*' } + , '/' ;
    single line block comment ::= "/*" , { single line comment character | ( { '*' } + , not slash star or line terminator ) } , { '*' } + , '/' ;
    single line comment character ::= ( U+0001 .. '\xFF' - ( '*' | U+000A | U+000D | '\xE2' ) ) | '\x00' | ( '\xE2' , '\x80' , not LS PS byte ) | ( '\xE2' , ( ! '\x80' .. '\x80' ) ) ;

    hashbang ::= "#!" , { line comment character } ;

    (* --- identifiers and keywords *)

    potential keyword ::= { identifier ascii } + ;
    identifier ascii ::= 'A' .. 'Z' | 'a' .. 'z' | '0' .. '9' | '_' | '$' ;
    name ::= identifier start , { identifier part } ;
    identifier start ::= 'A' .. 'Z' | 'a' .. 'z' | '_' | '$' | unicode escape | non ascii identifier character ;
    identifier part ::= 'A' .. 'Z' | 'a' .. 'z' | '0' .. '9' | '_' | '$' | unicode escape | non ascii identifier character ;
    unicode escape ::= "\\u" , ( ( hex digit , hex digit , hex digit , hex digit ) | ( '{' , { hex digit } + , '}' ) ) ;
    (* (any non-ASCII character but those that are white space or line terminators: the compiler checks ID_Start and ID_Continue) *)
    non ascii identifier character ::=
        ( '\xC2' , ( '\x80' .. '\x9F' | '\xA1' .. '\xBF' ) ) |
        ( '\xC3' .. '\xDF' , continuation byte ) |
        ( '\xE0' , continuation byte , continuation byte ) |
        ( '\xE1' , continuation not x9A , continuation byte ) |
        ( '\xE1' , '\x9A' , ( '\x81' .. '\xBF' ) ) |
        ( '\xE2' , '\x80' , ( '\x8B' .. '\xA7' | '\xAA' .. '\xAE' | '\xB0' .. '\xBF' ) ) |
        ( '\xE2' , '\x81' , continuation not x9F ) |
        ( '\xE2' , ( '\x82' .. '\xBF' ) , continuation byte ) |
        ( '\xE3' , '\x80' , ( '\x81' .. '\xBF' ) ) |
        ( '\xE3' , ( '\x81' .. '\xBF' ) , continuation byte ) |
        ( '\xE4' .. '\xEE' , continuation byte , continuation byte ) |
        ( '\xEF' , continuation not xBB , continuation byte ) |
        ( '\xEF' , '\xBB' , ( '\x80' .. '\xBE' ) ) |
        ( '\xF0' .. '\xF4' , continuation byte , continuation byte , continuation byte ) ;
    continuation byte ::= '\x80' .. '\xBF' ;
    continuation not x9A ::= ( '\x80' .. '\xBF' - ( '\x9A' | '\x9A' ) ) | '\x00' ;
    continuation not x9F ::= ( '\x80' .. '\xBF' - ( '\x9F' | '\x9F' ) ) | '\x00' ;
    continuation not xBB ::= ( '\x80' .. '\xBF' - ( '\xBB' | '\xBB' ) ) | '\x00' ;

    (* (identifiers that are references, bindings and labels are not reserved words (the contextual keywords are the compiler's)) *)
    identifier reference $ javascript.identifier ::= name - ( "break" | "case" | "catch" | "class" | "const" | "continue" | "debugger" | "default" | "delete" | "do" | "else" | "enum" | "export" | "extends" | "false" | "finally" | "for" | "function" | "if" | "import" | "in" | "instanceof" | "new" | "null" | "return" | "super" | "switch" | "this" | "throw" | "true" | "try" | "typeof" | "var" | "void" | "while" | "with" ) ;
    binding identifier $ javascript.binding ::= name - ( "break" | "case" | "catch" | "class" | "const" | "continue" | "debugger" | "default" | "delete" | "do" | "else" | "enum" | "export" | "extends" | "false" | "finally" | "for" | "function" | "if" | "import" | "in" | "instanceof" | "new" | "null" | "return" | "super" | "switch" | "this" | "throw" | "true" | "try" | "typeof" | "var" | "void" | "while" | "with" ) ;
    label identifier $ javascript.label ::= name - ( "break" | "case" | "catch" | "class" | "const" | "continue" | "debugger" | "default" | "delete" | "do" | "else" | "enum" | "export" | "extends" | "false" | "finally" | "for" | "function" | "if" | "import" | "in" | "instanceof" | "new" | "null" | "return" | "super" | "switch" | "this" | "throw" | "true" | "try" | "typeof" | "var" | "void" | "while" | "with" ) ;
    identifier name $ javascript.name ::= name ;
    private identifier $ javascript.private ::= '#' , name ;

    (* (keywords: a potential keyword that is exactly the keyword (so not part of a longer name)) *)
    async $ language.keyword ::= potential keyword ::= "async" ;
    await $ language.keyword ::= potential keyword ::= "await" ;
    break $ language.keyword ::= potential keyword ::= "break" ;
    case $ language.keyword ::= potential keyword ::= "case" ;
    catch $ language.keyword ::= potential keyword ::= "catch" ;
    class $ language.keyword ::= potential keyword ::= "class" ;
    const $ language.keyword ::= potential keyword ::= "const" ;
    continue $ language.keyword ::= potential keyword ::= "continue" ;
    debugger $ language.keyword ::= potential keyword ::= "debugger" ;
    default $ language.keyword ::= potential keyword ::= "default" ;
    delete $ language.keyword ::= potential keyword ::= "delete" ;
    do $ language.keyword ::= potential keyword ::= "do" ;
    else $ language.keyword ::= potential keyword ::= "else" ;
    export $ language.keyword ::= potential keyword ::= "export" ;
    extends $ language.keyword ::= potential keyword ::= "extends" ;
    finally $ language.keyword ::= potential keyword ::= "finally" ;
    for $ language.keyword ::= potential keyword ::= "for" ;
    from $ language.keyword ::= potential keyword ::= "from" ;
    function $ language.keyword ::= potential keyword ::= "function" ;
    get $ language.keyword ::= potential keyword ::= "get" ;
    if $ language.keyword ::= potential keyword ::= "if" ;
    import $ language.keyword ::= potential keyword ::= "import" ;
    in $ language.keyword ::= potential keyword ::= "in" ;
    instanceof $ language.keyword ::= potential keyword ::= "instanceof" ;
    let $ language.keyword ::= potential keyword ::= "let" ;
    new $ language.keyword ::= potential keyword ::= "new" ;
    of $ language.keyword ::= potential keyword ::= "of" ;
    return $ language.keyword ::= potential keyword ::= "return" ;
    set $ language.keyword ::= potential keyword ::= "set" ;
    static $ language.keyword ::= potential keyword ::= "static" ;
    super $ language.keyword ::= potential keyword ::= "super" ;
    switch $ language.keyword ::= potential keyword ::= "switch" ;
    target $ language.keyword ::= potential keyword ::= "target" ;
    meta $ language.keyword ::= potential keyword ::= "meta" ;
    this $ language.keyword ::= potential keyword ::= "this" ;
    throw $ language.keyword ::= potential keyword ::= "throw" ;
    try $ language.keyword ::= potential keyword ::= "try" ;
    typeof $ language.keyword ::= potential keyword ::= "typeof" ;
    using $ language.keyword ::= potential keyword ::= "using" ;
    var $ language.keyword ::= potential keyword ::= "var" ;
    void $ language.keyword ::= potential keyword ::= "void" ;
    while $ language.keyword ::= potential keyword ::= "while" ;
    with $ language.keyword ::= potential keyword ::= "with" ;
    yield $ language.keyword ::= potential keyword ::= "yield" ;
    as $ language.keyword ::= potential keyword ::= "as" ;
    null keyword ::= potential keyword ::= "null" ;
    true keyword ::= potential keyword ::= "true" ;
    false keyword ::= potential keyword ::= "false" ;

    (* --- literals *)

    null literal $ javascript.null ::= null keyword ;
    true literal $ javascript.true ::= true keyword ;
    false literal $ javascript.false ::= false keyword ;
    this expression $ javascript.this ::= this ;

    numeric literal $ javascript.number ::= ( bigint literal | hex integer | octal integer | binary integer | decimal literal | legacy octal ) ;
    bigint literal ::= ( hex integer | octal integer | binary integer | decimal integer ) , 'n' ;
    hex integer ::= '0' , ( 'x' | 'X' ) , hex digit , { hex digit | ( '_' , hex digit ) } ;
    octal integer ::= '0' , ( 'o' | 'O' ) , octal digit , { octal digit | ( '_' , octal digit ) } ;
    binary integer ::= '0' , ( 'b' | 'B' ) , binary digit , { binary digit | ( '_' , binary digit ) } ;
    legacy octal ::= '0' , { digit } + ;
    decimal integer ::= ( '0' ) | ( '1' .. '9' , { digit | ( '_' , digit ) } ) ;
    decimal literal ::=
        ( decimal digits , [ '.' , [ decimal digits ] ] , [ exponent part ] ) | ( '.' , decimal digits , [ exponent part ] ) ;
    decimal digits ::= digit , { digit | ( '_' , digit ) } ;
    exponent part ::= ( 'e' | 'E' ) , [ '+' | '-' ] , decimal digits ;
    digit ::= '0' .. '9' ;
    hex digit ::= '0' .. '9' | 'a' .. 'f' | 'A' .. 'F' ;
    octal digit ::= '0' .. '7' ;
    binary digit ::= '0' | '1' ;

    string literal $ javascript.string ::=
        ( '\"' , { ( U+0001 .. '\xFF' - ( '\"' | '\\' | U+000A | U+000D ) ) | '\x00' | escape sequence } , '\"' ) |
        ( '\'' , { ( U+0001 .. '\xFF' - ( '\'' | '\\' | U+000A | U+000D ) ) | '\x00' | escape sequence } , '\'' ) ;
    escape sequence ::= '\\' , ( ( ! U+000D .. U+000D ) | ( U+000D , [ U+000A ] ) ) ;

    template literal $ javascript.template ::= '`' , { template characters | template substitution | template dollar } , '`' ;
    template characters $ javascript.template.string ::= { ( U+0001 .. '\xFF' - ( '`' | '\\' | '$' ) ) | '\x00' | escape sequence } + ;
    template dollar $ javascript.template.string ::= '$' ;
    template substitution ::= "${" , WS , expression , WS , '}' ;

    regular expression literal $ javascript.regexp ::= '/' , regexp first character , { regexp character } , '/' , { identifier part } ;
    regexp first character ::= ( U+0001 .. '\xFF' - ( '*' | '\\' | '/' | '[' | U+000A | U+000D ) ) | '\x00' | regexp backslash | regexp class ;
    regexp character ::= ( U+0001 .. '\xFF' - ( '/' | '\\' | '[' | U+000A | U+000D ) ) | '\x00' | regexp backslash | regexp class ;
    regexp backslash ::= '\\' , not line terminator byte ;
    regexp class ::= '[' , { ( U+0001 .. '\xFF' - ( ']' | '\\' | U+000A | U+000D ) ) | '\x00' | regexp backslash } , ']' ;

    (* --- expressions *)

    primary expression ::=
        this expression |
        null literal |
        true literal |
        false literal |
        numeric literal |
        string literal |
        template literal |
        regular expression literal |
        array literal |
        object literal |
        function expression |
        async function expression |
        class expression |
        identifier reference |
        parenthesized expression ;

    parenthesized expression $ javascript.parenthesized ::= '(' , WS , expression , WS , ')' ;

    array literal $ javascript.array ::= '[' , WS , [ element list ] , WS , ']' ;
    element list ::= { array element / ( elision ) } + ;
    array element ::= ( spread element | assignment expression ) , WS , [ ',' , WS ] ;
    elision $ javascript.hole ::= ',' , WS ;
    spread element $ javascript.spread ::= "..." , WS , assignment expression ;

    object literal $ javascript.object ::= '{' , WS , [ property definition , { WS , ',' , WS , property definition } , [ WS , ',' ] ] , WS , '}' ;
    property definition ::=
        spread element /
        method definition /
        property assignment /
        cover initialized name /
        shorthand property ;
    property assignment $ javascript.property ::= property name , WS , ':' , WS , assignment expression ;
    shorthand property $ javascript.shorthand ::= identifier reference ;
    cover initialized name $ javascript.shorthand.default ::= identifier reference , WS , '=' , WS , assignment expression ;
    property name ::= literal property name | computed property name ;
    literal property name ::= identifier name | string literal | numeric literal ;
    computed property name $ javascript.computed ::= '[' , WS , assignment expression , WS , ']' ;
    class element name ::= property name | private identifier ;

    method definition ::=
        getter method /
        setter method /
        async generator method /
        async method /
        generator method /
        plain method ;
    plain method $ javascript.method ::= class element name , WS , method parameters , WS , function body ;
    getter method $ javascript.getter ::= get , WS , class element name , WS , method parameters , WS , function body ;
    setter method $ javascript.setter ::= set , WS , class element name , WS , method parameters , WS , function body ;
    generator method $ javascript.method.generator ::= '*' , WS , class element name , WS , method parameters , WS , function body ;
    async method $ javascript.method.async ::= async , S , class element name , WS , method parameters , WS , function body ;
    async generator method $ javascript.method.async.generator ::= async , S , '*' , WS , class element name , WS , method parameters , WS , function body ;
    method parameters ::= formal parameters ;

    function expression $ javascript.function.expression ::=
        function , WS , [ '*' , WS ] , [ binding identifier , WS ] , formal parameters , WS , function body ;
    async function expression $ javascript.function.expression.async ::=
        async , S , function , WS , [ '*' , WS ] , [ binding identifier , WS ] , formal parameters , WS , function body ;

    formal parameters $ javascript.parameters ::= '(' , WS , [ formal parameter list ] , WS , ')' ;
    formal parameter list ::= ( rest parameter ) | ( formal parameter , { WS , ',' , WS , formal parameter } , [ WS , ',' , WS , rest parameter ] , [ WS , ',' ] ) ;
    formal parameter ::= binding element ;
    rest parameter $ javascript.pattern.rest ::= "..." , WS , binding target ;
    function body $ javascript.body ::= '{' , WS , { statement list item , WS } , '}' ;

    arrow function $ javascript.arrow ::= arrow parameters , S , "=>" , WS , concise body ;
    async arrow function $ javascript.arrow.async ::= async , S , arrow parameters , S , "=>" , WS , concise body ;
    arrow parameters ::= single arrow parameter | formal parameters ;
    single arrow parameter $ javascript.parameters ::= binding identifier ;
    concise body ::= function body / assignment expression ;
    arrow function no in $ javascript.arrow ::= arrow parameters , S , "=>" , WS , concise body no in ;
    async arrow function no in $ javascript.arrow.async ::= async , S , arrow parameters , S , "=>" , WS , concise body no in ;
    concise body no in ::= function body / assignment no in expression ;

    class expression $ javascript.class.expression ::= class , WS , [ binding identifier , WS ] , class tail ;
    class tail ::= [ class heritage , WS ] , '{' , WS , { class element , WS } , '}' ;
    class heritage $ javascript.extends ::= extends , WS , left hand side expression ;
    class element ::=
        static block /
        static method /
        method definition /
        static field /
        field definition /
        empty class element ;
    static method $ javascript.static ::= static , WS , method definition ;
    static field $ javascript.static ::= static , WS , field definition ;
    field definition $ javascript.field ::= class element name , [ WS , '=' , WS , assignment expression ] , terminator ;
    static block $ javascript.static.block ::= static , WS , '{' , WS , { statement list item , WS } , '}' ;
    empty class element ::= ';' ;

    member expression ::= member head , { WS , member suffix } ;
    member head ::=
        super property |
        new target |
        import meta |
        new expression with arguments |
        primary expression ;
    member suffix ::= dot access | index access | private access | tagged template ;
    dot access $ javascript.dot ::= '.' , WS , identifier name ;
    private access $ javascript.dot.private ::= '.' , WS , private identifier ;
    index access $ javascript.index ::= '[' , WS , expression , WS , ']' ;
    tagged template $ javascript.tagged ::= template literal ;
    super property $ javascript.super.dot ::= super , WS , '.' , WS , identifier name ;
    super property $ javascript.super.index ::= super , WS , '[' , WS , expression , WS , ']' ;
    new target $ javascript.new.target ::= new , WS , '.' , WS , target ;
    import meta $ javascript.import.meta ::= import , WS , '.' , WS , meta ;
    new expression with arguments $ javascript.new ::= new , WS , member expression , WS , new arguments ;
    new expression without arguments $ javascript.new ::= new , WS , new expression ;
    new expression ::= member expression | new expression without arguments ;
    new arguments $ javascript.arguments ::= arguments ;
    arguments ::= '(' , WS , [ argument list ] , WS , ')' ;
    argument list ::= ( spread element | assignment expression ) , { WS , ',' , WS , ( spread element | assignment expression ) } , [ WS , ',' ] ;

    call expression ::= call head , { WS , call suffix } ;
    call head ::= super call | import call | ( member expression , WS , call arguments ) ;
    call suffix ::= call arguments | dot access | index access | private access | tagged template ;
    call arguments $ javascript.call ::= arguments ;
    super call $ javascript.super.call ::= super , WS , arguments ;
    import call $ javascript.import.call ::= import , WS , '(' , WS , assignment expression , [ WS , ',' , WS , assignment expression ] , [ WS , ',' ] , WS , ')' ;

    optional expression $ javascript.optional ::= ( call expression | member expression ) , WS , optional chain , { WS , optional chain } ;
    optional chain ::= optional head , { WS , ( call arguments | dot access | index access | private access | tagged template ) } ;
    optional head ::= optional call | optional index | optional private | optional dot ;
    optional call $ javascript.optional.call ::= "?." , WS , arguments ;
    optional index $ javascript.optional.index ::= "?." , WS , '[' , WS , expression , WS , ']' ;
    optional dot $ javascript.optional.dot ::= "?." , WS , identifier name ;
    optional private $ javascript.optional.private ::= "?." , WS , private identifier ;

    left hand side expression ::= optional expression | call expression | new expression ;

    update expression ::= prefix increment | prefix decrement | postfix expression ;
    prefix increment $ javascript.preincrement ::= "++" , WS , unary expression ;
    prefix decrement $ javascript.predecrement ::= "--" , WS , unary expression ;
    postfix expression ::= left hand side expression , [ S , ( postfix increment | postfix decrement ) ] ;
    postfix increment $ javascript.postincrement ::= "++" ;
    postfix decrement $ javascript.postdecrement ::= "--" ;

    unary expression ::=
        delete expression | void expression | typeof expression | plus expression | negate expression |
        bitwise not expression | not expression | await expression | update expression ;
    delete expression $ javascript.delete ::= delete , WS , unary expression ;
    void expression $ javascript.void ::= void , WS , unary expression ;
    typeof expression $ javascript.typeof ::= typeof , WS , unary expression ;
    plus expression $ javascript.plus ::= '+' , WS , unary expression ;
    negate expression $ javascript.negate ::= '-' , WS , unary expression ;
    bitwise not expression $ javascript.bitnot ::= '~' , WS , unary expression ;
    not expression $ javascript.not ::= '!' , WS , unary expression ;
    await expression $ javascript.await ::= await , WS , unary expression ;

    exponentiation expression ::= ( update expression , [ WS , exponent tail ] ) | unary expression ;
    exponent tail $ javascript.exponent ::= "**" , WS , exponentiation expression ;

    multiplicative expression ::= exponentiation expression , { WS , ( multiply tail | divide tail | remainder tail ) } ;
    multiply tail $ javascript.multiply ::= '*' , WS , exponentiation expression ;
    divide tail $ javascript.divide ::= '/' , WS , exponentiation expression ;
    remainder tail $ javascript.remainder ::= '%' , WS , exponentiation expression ;

    additive expression ::= multiplicative expression , { WS , ( add tail | subtract tail ) } ;
    add tail $ javascript.add ::= binary plus , WS , multiplicative expression ;
    binary plus ::= ( '+' , [ '+' ] ) - "++" ; (* (not the first character of "++") *)
    subtract tail $ javascript.subtract ::= binary minus , WS , multiplicative expression ;
    binary minus ::= ( '-' , [ '-' ] ) - "--" ; (* (not the first character of "--") *)

    shift expression ::= additive expression , { WS , ( shift left tail | shift right unsigned tail | shift right tail ) } ;
    shift left tail $ javascript.shiftleft ::= "<<" , WS , additive expression ;
    shift right tail $ javascript.shiftright ::= ">>" , WS , additive expression ;
    shift right unsigned tail $ javascript.shiftrightunsigned ::= ">>>" , WS , additive expression ;

    relational expression ::= ( shift expression | private in ) , { WS , relational tail } ;
    relational no in expression ::= ( shift expression | private in ) , { WS , relational no in tail } ;
    relational tail ::= less than tail | greater than tail | less equal tail | greater equal tail | instanceof tail | in tail ;
    relational no in tail ::= less than tail | greater than tail | less equal tail | greater equal tail | instanceof tail ;
    less than tail $ javascript.lessthan ::= less than , WS , shift expression ;
    less than ::= ( '<' , [ "!--" ] ) - "<!--" ; (* (not the start of an HTML-like comment (Annex B.1.1)) *)
    greater than tail $ javascript.greaterthan ::= '>' , WS , shift expression ;
    less equal tail $ javascript.lessequal ::= "<=" , WS , shift expression ;
    greater equal tail $ javascript.greaterequal ::= ">=" , WS , shift expression ;
    instanceof tail $ javascript.instanceof ::= instanceof , WS , shift expression ;
    in tail $ javascript.in ::= in , WS , shift expression ;
    private in $ javascript.private.in ::= private identifier , WS , in , WS , shift expression ;

    equality expression ::= relational expression , { WS , equality tail } ;
    equality no in expression ::= relational no in expression , { WS , equality no in tail } ;
    equality tail ::= strict equal tail | strict not equal tail | equal tail | not equal tail ;
    equality no in tail ::= strict equal no in tail | strict not equal no in tail | equal no in tail | not equal no in tail ;
    strict equal tail $ javascript.strictequal ::= "===" , WS , relational expression ;
    strict not equal tail $ javascript.strictnotequal ::= "!==" , WS , relational expression ;
    equal tail $ javascript.equal ::= "==" , WS , relational expression ;
    not equal tail $ javascript.notequal ::= "!=" , WS , relational expression ;
    strict equal no in tail $ javascript.strictequal ::= "===" , WS , relational no in expression ;
    strict not equal no in tail $ javascript.strictnotequal ::= "!==" , WS , relational no in expression ;
    equal no in tail $ javascript.equal ::= "==" , WS , relational no in expression ;
    not equal no in tail $ javascript.notequal ::= "!=" , WS , relational no in expression ;

    bitwise and expression ::= equality expression , { WS , bitwise and tail } ;
    bitwise and tail $ javascript.bitand ::= '&' , WS , equality expression ;
    bitwise xor expression ::= bitwise and expression , { WS , bitwise xor tail } ;
    bitwise xor tail $ javascript.bitxor ::= '^' , WS , bitwise and expression ;
    bitwise or expression ::= bitwise xor expression , { WS , bitwise or tail } ;
    bitwise or tail $ javascript.bitor ::= '|' , WS , bitwise xor expression ;
    logical and expression ::= bitwise or expression , { WS , logical and tail } ;
    logical and tail $ javascript.and ::= "&&" , WS , bitwise or expression ;
    logical or expression ::= logical and expression , { WS , logical or tail } ;
    logical or tail $ javascript.or ::= "||" , WS , logical and expression ;
    coalesce expression ::= bitwise or expression , { WS , coalesce tail } + ;
    coalesce tail $ javascript.coalesce ::= "??" , WS , bitwise or expression ;
    short circuit expression ::= logical or expression | coalesce expression ;

    bitwise and no in expression ::= equality no in expression , { WS , bitwise and no in tail } ;
    bitwise and no in tail $ javascript.bitand ::= '&' , WS , equality no in expression ;
    bitwise xor no in expression ::= bitwise and no in expression , { WS , bitwise xor no in tail } ;
    bitwise xor no in tail $ javascript.bitxor ::= '^' , WS , bitwise and no in expression ;
    bitwise or no in expression ::= bitwise xor no in expression , { WS , bitwise or no in tail } ;
    bitwise or no in tail $ javascript.bitor ::= '|' , WS , bitwise xor no in expression ;
    logical and no in expression ::= bitwise or no in expression , { WS , logical and no in tail } ;
    logical and no in tail $ javascript.and ::= "&&" , WS , bitwise or no in expression ;
    logical or no in expression ::= logical and no in expression , { WS , logical or no in tail } ;
    logical or no in tail $ javascript.or ::= "||" , WS , logical and no in expression ;
    coalesce no in expression ::= bitwise or no in expression , { WS , coalesce no in tail } + ;
    coalesce no in tail $ javascript.coalesce ::= "??" , WS , bitwise or no in expression ;
    short circuit no in expression ::= logical or no in expression | coalesce no in expression ;

    conditional expression ::= short circuit expression , [ WS , conditional tail ] ;
    conditional tail $ javascript.conditional ::= '?' , WS , assignment expression , WS , ':' , WS , assignment expression ;
    conditional no in expression ::= short circuit no in expression , [ WS , conditional no in tail ] ;
    conditional no in tail $ javascript.conditional ::= '?' , WS , assignment expression , WS , ':' , WS , assignment no in expression ;

    assignment expression ::= arrow function | async arrow function | yield expression | assignment | conditional expression ;
    assignment no in expression ::= arrow function no in | async arrow function no in | yield no in expression | assignment no in | conditional no in expression ;
    assignment $ javascript.assign ::= left hand side expression , WS , assignment operator , WS , assignment expression ;
    assignment no in $ javascript.assign ::= left hand side expression , WS , assignment operator , WS , assignment no in expression ;
    assignment operator ::=
        "=" | "*=" | "/=" | "%=" | "+=" | "-=" | "<<=" | ">>=" | ">>>=" | "&=" | "^=" | "|=" | "**=" | "&&=" | "||=" | "??=" ;
    yield expression $ javascript.yield ::= yield , [ S , [ '*' , WS ] , assignment expression ] ;
    yield no in expression $ javascript.yield ::= yield , [ S , [ '*' , WS ] , assignment no in expression ] ;

    expression ::= assignment expression , { WS , comma tail } ;
    expression no in ::= assignment no in expression , { WS , comma no in tail } ;
    comma tail $ javascript.comma ::= ',' , WS , assignment expression ;
    comma no in tail $ javascript.comma ::= ',' , WS , assignment no in expression ;

    (* --- binding patterns *)

    binding target ::= binding identifier | object binding pattern | array binding pattern ;
    binding element ::= binding initializer / binding target ;
    binding initializer $ javascript.initializer ::= binding target , WS , '=' , WS , assignment expression ;
    object binding pattern $ javascript.pattern.object ::= '{' , WS , [ binding property list ] , WS , '}' ;
    binding property list ::= ( binding rest property ) | ( binding property , { WS , ',' , WS , binding property } , [ WS , ',' , WS , binding rest property ] , [ WS , ',' ] ) ;
    binding property ::= binding property with name / binding element ;
    binding property with name $ javascript.pattern.property ::= property name , WS , ':' , WS , binding element ;
    binding rest property $ javascript.pattern.rest ::= "..." , WS , binding identifier ;
    array binding pattern $ javascript.pattern.array ::= '[' , WS , { binding array item } , WS , ']' ;
    binding array item ::= ( binding rest element , WS , [ ',' , WS ] ) / ( binding element , WS , [ ',' , WS ] ) / binding elision ;
    binding elision $ javascript.hole ::= ',' , WS ;
    binding rest element $ javascript.pattern.rest ::= "..." , WS , binding target ;

    (* --- statements *)

    terminator ::= [ WS , ';' ] ; (* (a ';' after a line terminator is still the statement's: continue \n ; else ...) *)

    statement ::=
        block statement /
        variable statement /
        empty statement /
        if statement /
        do statement /
        while statement /
        for statement /
        continue statement /
        break statement /
        return statement /
        with statement /
        switch statement /
        throw statement /
        try statement /
        debugger statement /
        labelled statement /
        expression statement ;

    declaration ::=
        function declaration /
        async function declaration /
        class declaration /
        lexical declaration /
        using declaration ;

    statement list item ::= declaration / statement ;

    block statement $ javascript.block ::= '{' , WS , { statement list item , WS } , '}' ;
    empty statement $ javascript.empty ::= ';' ;
    expression statement $ javascript.expression ::= expression , terminator ;
    debugger statement $ javascript.debugger ::= debugger , terminator ;

    variable statement $ javascript.var ::= var , WS , variable declaration list , terminator ;
    lexical declaration $ javascript.let ::= let , WS , variable declaration list , terminator ;
    lexical declaration $ javascript.const ::= const , WS , variable declaration list , terminator ;
    using declaration $ javascript.using ::= using , S , using declaration list , terminator ;
    using declaration $ javascript.await.using ::= await , S , using , S , using declaration list , terminator ;
    using declaration list ::= using variable declaration , { WS , ',' , WS , using variable declaration } ;
    using variable declaration $ javascript.declarator ::= binding identifier , [ WS , '=' , WS , assignment expression ] ;
    using declaration list no in ::= using variable declaration no in , { WS , ',' , WS , using variable declaration no in } ;
    using variable declaration no in $ javascript.declarator ::= binding identifier , [ WS , '=' , WS , assignment no in expression ] ;
    variable declaration list ::= variable declaration , { WS , ',' , WS , variable declaration } ;
    variable declaration $ javascript.declarator ::= binding target , [ WS , '=' , WS , assignment expression ] ;
    variable declaration list no in ::= variable declaration no in , { WS , ',' , WS , variable declaration no in } ;
    variable declaration no in $ javascript.declarator ::= binding target , [ WS , '=' , WS , assignment no in expression ] ;

    if statement $ javascript.if ::= if , WS , '(' , WS , expression , WS , ')' , WS , statement , [ WS , else , WS , statement ] ;
    do statement $ javascript.do ::= do , WS , statement , WS , while , WS , '(' , WS , expression , WS , ')' , terminator ;
    while statement $ javascript.while ::= while , WS , '(' , WS , expression , WS , ')' , WS , statement ;

    for statement ::= for classic statement / for in statement / for of statement / for await of statement ;
    for classic statement $ javascript.for ::=
        for , WS , '(' , WS , [ for init ] , WS , ';' , WS , [ for test ] , WS , ';' , WS , [ for update ] , WS , ')' , WS , statement ;
    for init $ javascript.for.init ::=
        ( var , WS , variable declaration list no in ) $ javascript.var |
        ( let , WS , variable declaration list no in ) $ javascript.let |
        ( const , WS , variable declaration list no in ) $ javascript.const |
        ( using , S , using declaration list no in ) $ javascript.using |
        ( await , S , using , S , using declaration list no in ) $ javascript.await.using |
        expression no in ;
    for test $ javascript.for.test ::= expression ;
    for update $ javascript.for.update ::= expression ;
    for in statement $ javascript.for.in ::= for , WS , '(' , WS , for binding , WS , in , WS , expression , WS , ')' , WS , statement ;
    for of statement $ javascript.for.of ::= for , WS , '(' , WS , for binding , WS , of , WS , assignment expression , WS , ')' , WS , statement ;
    for await of statement $ javascript.for.await.of ::=
        for , WS , await , WS , '(' , WS , for binding , WS , of , WS , assignment expression , WS , ')' , WS , statement ;
    for binding ::= for var binding / for let binding / for const binding / for using binding / for await using binding / left hand side expression ;
    for var binding $ javascript.for.var ::= var , WS , ( binding target | legacy for in initializer ) ;
    for let binding $ javascript.for.let ::= let , WS , binding target ;
    for const binding $ javascript.for.const ::= const , WS , binding target ;
    for using binding $ javascript.for.using ::= using , S , for using identifier ;
    for await using binding $ javascript.for.await.using ::= await , S , using , S , binding identifier ;
    for using identifier $ javascript.binding ::= name - ( "break" | "case" | "catch" | "class" | "const" | "continue" | "debugger" | "default" | "delete" | "do" | "else" | "enum" | "export" | "extends" | "false" | "finally" | "for" | "function" | "if" | "import" | "in" | "instanceof" | "new" | "null" | "return" | "super" | "switch" | "this" | "throw" | "true" | "try" | "typeof" | "var" | "void" | "while" | "with" | "of" ) ; (* (for (using of ...): using is an identifier) *)
    legacy for in initializer $ javascript.initializer ::= binding identifier , WS , '=' , WS , assignment no in expression ;

    continue statement $ javascript.continue ::= continue , [ S , label identifier ] , terminator ;
    break statement $ javascript.break ::= break , [ S , label identifier ] , terminator ;
    return statement $ javascript.return ::= return , [ S , expression ] , terminator ;
    throw statement $ javascript.throw ::= throw , S , expression , terminator ;
    with statement $ javascript.with ::= with , WS , '(' , WS , expression , WS , ')' , WS , statement ;
    switch statement $ javascript.switch ::= switch , WS , '(' , WS , expression , WS , ')' , WS , '{' , WS , { case clause , WS } , '}' ;
    case clause ::= case clause with test | default clause ;
    case clause with test $ javascript.case ::= case , WS , expression , WS , ':' , WS , { statement list item , WS } ;
    default clause $ javascript.default ::= default , WS , ':' , WS , { statement list item , WS } ;
    labelled statement $ javascript.labelled ::= label identifier , WS , ':' , WS , ( function declaration / statement ) ;
    try statement $ javascript.try ::= try , WS , block statement , WS , ( ( catch clause , [ WS , finally clause ] ) | finally clause ) ;
    catch clause $ javascript.catch ::= catch , WS , [ '(' , WS , binding target , WS , ')' , WS ] , block statement ;
    finally clause $ javascript.finally ::= finally , WS , block statement ;

    function declaration $ javascript.function ::=
        function , WS , [ '*' , WS ] , binding identifier , WS , formal parameters , WS , function body ;
    async function declaration $ javascript.function.async ::=
        async , S , function , WS , [ '*' , WS ] , binding identifier , WS , formal parameters , WS , function body ;
    class declaration $ javascript.class ::= class , WS , binding identifier , WS , class tail ;

    (* --- modules *)

    import declaration $ javascript.import ::= import , WS , ( ( import clause , WS , from , WS , module specifier ) | module specifier ) , [ WS , import attributes ] , terminator ;
    import clause ::=
        ( imported default binding , WS , ',' , WS , ( namespace import | named imports ) ) /
        imported default binding /
        namespace import /
        named imports ;
    imported default binding $ javascript.import.default ::= binding identifier ;
    namespace import $ javascript.import.namespace ::= '*' , WS , as , WS , binding identifier ;
    named imports $ javascript.import.named ::= '{' , WS , [ import specifier , { WS , ',' , WS , import specifier } , [ WS , ',' ] ] , WS , '}' ;
    import specifier $ javascript.import.specifier ::= ( module export name , WS , as , WS , binding identifier ) | binding identifier ;
    module export name ::= identifier name | string literal ;
    module specifier ::= string literal ;
    import attributes $ javascript.import.attributes ::= with , WS , '{' , WS , [ import attribute , { WS , ',' , WS , import attribute } , [ WS , ',' ] ] , WS , '}' ;
    import attribute ::= ( identifier name | string literal ) , WS , ':' , WS , string literal ;
    export declaration $ javascript.export ::= export , WS , (
        ( '*' , [ WS , as , WS , module export name ] , WS , from , WS , module specifier , [ WS , import attributes ] , terminator ) /
        ( named exports , WS , from , WS , module specifier , [ WS , import attributes ] , terminator ) /
        ( named exports , terminator ) /
        variable statement /
        declaration /
        ( default , WS , ( function declaration / async function declaration / class declaration / anonymous default ) ) ) ;
    anonymous default ::=
        ( function , WS , [ '*' , WS ] , formal parameters , WS , function body ) $ javascript.function.expression /
        ( async , S , function , WS , [ '*' , WS ] , formal parameters , WS , function body ) $ javascript.function.expression.async /
        ( class , WS , class tail ) $ javascript.class.expression /
        ( assignment expression , terminator ) $ javascript.export.default ;
    named exports $ javascript.export.named ::= '{' , WS , [ export specifier , { WS , ',' , WS , export specifier } , [ WS , ',' ] ] , WS , '}' ;
    export specifier $ javascript.export.specifier ::= module export name , [ WS , as , WS , module export name ] ;
    module item ::= import declaration / export declaration / statement list item ;

    (* --- programs (a script, or a module if the compiler is told it is one: its import and export declarations are then allowed) *)

    program $ javascript.script ::= [ hashbang ] , [ html close comment ] , WS , { module item , WS } ;
}#
